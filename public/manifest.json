{
  "id": "/",
  "name": "KookyeCatCloud",
  "short_name": "KookyeCat",
  "description": "Tu nube privada de archivos, fotos y productividad con niveles, retos y logros",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#04070f",
  "theme_color": "#070b16",
  "orientation": "portrait-primary",
  "categories": [
    "productivity",
    "utilities",
    "photo"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Portapapeles",
      "short_name": "Portapapeles",
      "description": "Enviar texto o archivos entre tus dispositivos",
      "url": "/#clip",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}

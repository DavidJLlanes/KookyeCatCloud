# Copia este archivo como .env y ajusta los valores.

# Secreto de firma de los tokens JWT. Genéralo con:
#   openssl rand -hex 32
# Si lo dejas vacío, el servidor crea uno aleatorio en .jwt-secret al arrancar.
JWT_SECRET=

# Dónde se guardan los archivos de los usuarios
DATA_DIR=/data/storage

# Puerto en el que escucha Node (Nginx hace de proxy delante)
PORT=4000

# Subcarpeta del dominio si no va en la raíz (p. ej. /cloud para midominio.es/cloud).
# Déjalo vacío para un dominio o subdominio propio.
BASE_PATH=

# Contraseña del admin en el PRIMER arranque. Si no la pones, se genera una
# aleatoria y se imprime en el log una única vez.
ADMIN_PASSWORD=

# Tamaño máximo por archivo subido, en bytes (por defecto 5 GB)
MAX_UPLOAD_BYTES=5368709120

# Pon 1 SOLO para desarrollo en http://localhost (quita el flag Secure de la cookie).
# En producción con HTTPS déjalo sin definir.
INSECURE_COOKIES=

# Días que un elemento permanece en la papelera antes de borrarse solo (por defecto 30)
TRASH_TTL_DAYS=30

# Enlaces de subida públicos (/u/<token>)
LINK_MAX_FILES=50
LINK_MAX_BYTES=2147483648
LINK_IP_HOURLY=200

# Bloc de notas
NOTES_LIMIT=5000
NOTE_MAX_CHARS=500000

# Lado mayor de la conversión HEIC para pantalla, en píxeles
DISPLAY_MAX=2200

# Visor de documentos
TEXT_MAX=524288          # máximo que se lee de un archivo de texto, en bytes
OFFICE_TIMEOUT=90000     # tope por conversión de LibreOffice, en ms

# Máximo de elementos por ZIP
ZIP_LIMIT=200

# Visor de hojas de cálculo
SHEET_MAX_ROWS=2000
SHEET_MAX_COLS=60

# Mapa de fotos
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_LIMIT=5000

# Registro de actividad: cuántas líneas como máximo se conservan (se recorta solo)
ACTIVITY_MAX=5000

# Buscador de duplicados: tope de archivos a examinar en un solo escaneo
DUP_LIMIT=20000

# Analizador de espacio por carpeta: tope de archivos a examinar por subcarpeta
DU_LIMIT=200000

# Versiones de archivos de texto: cuántas se guardan por archivo, cuántos días y tamaño máximo en bytes
VERSIONS_KEEP=30
VERSIONS_DAYS=180
VERSIONS_MAX_BYTES=5242880

# Caja fuerte: minutos sin usarla tras los que se bloquea sola
VAULT_IDLE_MIN=15

# Passkeys (huella / Face ID): normalmente no hace falta tocarlos, se deducen del dominio.
# Solo si el proxy no pasa bien Host / X-Forwarded-Proto:
# WEBAUTHN_RP_ID=cloud.midominio.es
# WEBAUTHN_ORIGIN=https://cloud.midominio.es
